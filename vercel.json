{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "npm ci && npm run prisma:generate",
      "buildCommand": "npm run build",
      "functions": { "src/main.ts": { "maxDuration": 60 } }
    }
  },
  "rewrites": [
    { "source": "/api/jobs/tick", "destination": { "service": "backend" } },
    { "source": "/api/health/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
