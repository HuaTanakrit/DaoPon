# Vercel project variables (shared services). Fill secrets in Vercel, not in Git.
# BACKEND_URL is injected by the service binding. Do not set it manually on Vercel.
NODE_ENV=production
DATABASE_URL=
API_FOOTBALL_KEY=
ADMIN_API_KEY=
CRON_SECRET=
BACKGROUND_JOBS_ENABLED=false
PREDICTION_SCORING_ENABLED=true
REPLAY_STATS_SYNC_ENABLED=true
AUTO_SYNC_ENABLED=false
FOOTBALL_DAILY_LIMIT=100
FRONTEND_URL=https://your-project.vercel.app
DEMO_CONTROLS_ENABLED=false
DEMO_CONTROL_TOKEN=
DEMO_ADMIN_EMAILS=
