NODE_ENV=development
PORT=3001
# Railway: set NODE_ENV=production and HOST=0.0.0.0; let Railway supply PORT.
FRONTEND_URL=http://localhost:3000

# Paste your Neon PostgreSQL connection string here.
# For compose.yaml: postgresql://football:football_dev@localhost:5432/premier_league
DATABASE_URL=
API_FOOTBALL_KEY=

# Required for POST /api/admin/sync/*; generate a long random value.
ADMIN_API_KEY=

# Enable only after migrations, API key, and season access are ready.
AUTO_SYNC_ENABLED=false
AUTO_SYNC_SEASON=2024

# Optional local Docker database password; not used with Neon.
POSTGRES_PASSWORD=football_dev

# Import historical match stats at minute 05 each hour, respecting replay time and quota.
REPLAY_STATS_SYNC_ENABLED=false

# Fetch starting XIs and award account points after replay kickoff + 3h.
PREDICTION_SCORING_ENABLED=false

# Local presentation controls; use the same private random token in frontend server env.
DEMO_CONTROLS_ENABLED=false
DEMO_CONTROL_TOKEN=

# HTTP scheduler: set on Vercel and send as Authorization: Bearer <value>.
CRON_SECRET=
# Disabled automatically on Vercel. HTTP jobs remain available when false.
BACKGROUND_JOBS_ENABLED=true
# Shared daily request cap; 5 calls are kept in reserve.
FOOTBALL_DAILY_LIMIT=100
